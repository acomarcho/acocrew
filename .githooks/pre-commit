#!/usr/bin/env bash
# Format and lint the files this commit touches. Whole-project checks (typecheck,
# tests) run in pre-push instead. Installed by scripts/install-hooks.sh; git finds
# this file through the shared hook dispatcher, so it runs in every worktree.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# Only the kinds of file vp checks. Images, lockfiles and the like are left out:
# a commit that touches nothing else then skips, instead of failing with
# "Expected at least one target file".
re='\.(m?[jt]sx?|c[jt]s|jsonc?|css|scss|html?|mdx?|ya?ml)$'

files=()
while IFS= read -r -d '' file; do
  if [[ $file =~ $re ]]; then
    files+=("$file")
  fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ ${#files[@]} -eq 0 ]; then
  exit 0
fi

# vp resolves vite.config.ts through the nearest node_modules, so the main
# checkout's binary cannot stand in for a worktree that was never installed.
# Those are scratch checkouts; say so and let the commit through.
if [ ! -x node_modules/.bin/vp ]; then
  echo "pre-commit: no node_modules here, skipping checks (run pnpm install to enable them)" >&2
  exit 0
fi

if ! ./node_modules/.bin/vp check --no-error-on-unmatched-pattern "${files[@]}"; then
  printf '\nFix formatting and lint, then commit again:\n  pnpm exec vp check --fix'
  printf ' %q' "${files[@]}"
  printf '\n'
  exit 1
fi
